    exit 0
}



# ── Online update check ───────────────────────────────
# Checks GitHub Releases API for newer versions when
# CHECK_UPDATES="true" (default: "false"). Silent on
# network errors, timeouts, and unparseable versions.
# Reports ONLY strictly-newer releases; equal or older
# remote versions are never announced on the console.
#
# Version parsing: anchored numeric-prefix regex
# (^MAJOR.MINOR[.PATCH]); dev suffixes (".DEV", "-rc1")
# are ignored — "1.2.DEV" compares as "1.2.0".
#
# Privacy contract: connects to api.github.com only if
# user opted in; transmits your IP via HTTP headers.
# The config comment warns about this before enabling.

check_for_updates() {
    # Gate 1: opt-in
    [[ "$CHECK_UPDATES" == "true" ]] || return 0

    # Gate 2: prerequisites
    command -v curl &>/dev/null || return 0
    command -v jq &>/dev/null || return 0

    local url remote_tag remote_ver
    local major minor patch remote_major remote_minor remote_patch cmp

    url="https://api.github.com/repos/rmltecdev/proton-drive-backup/releases/latest"

    # Fetch tag_name (timeout 5s, silent failure)
    remote_tag=$(curl -sS --max-time 5 \
        -H "Accept: application/vnd.github.v3+json" \
        "$url" 2>/dev/null | jq -r '.tag_name // empty')

    [[ -n "$remote_tag" ]] || {
        log "[INFO] Update check: no release metadata received."
        return 0
    }

    # ── Parse remote: strip leading 'v', anchored numeric prefix ──
    remote_ver="${remote_tag#v}"
    if [[ "$remote_ver" =~ ^([0-9]+)\.([0-9]+)(\.([0-9]+))? ]]; then
        remote_major="${BASH_REMATCH[1]}"
        remote_minor="${BASH_REMATCH[2]}"
        remote_patch="${BASH_REMATCH[4]:-0}"
    else
        log "[INFO] Update check: unparseable remote tag '$remote_tag'."
        return 0
    fi

    # ── Parse local: same regex; dev suffixes fall away
    # because the match anchors on the numeric prefix ──
    if [[ "$VERSION" =~ ^([0-9]+)\.([0-9]+)(\.([0-9]+))? ]]; then
        major="${BASH_REMATCH[1]}"
        minor="${BASH_REMATCH[2]}"
        patch="${BASH_REMATCH[4]:-0}"
    else
        log "[INFO] Update check: unparseable local version '$VERSION'."
        return 0
    fi

    # Semantic comparison: cmp = 1 (remote newer), 0 (equal), -1 (older)
    if (( remote_major > major )); then
        cmp=1
    elif (( remote_major < major )); then
        cmp=-1
    elif (( remote_minor > minor )); then
        cmp=1
    elif (( remote_minor < minor )); then
        cmp=-1
    elif (( remote_patch > patch )); then
        cmp=1
    elif (( remote_patch < patch )); then
        cmp=-1
    else
        cmp=0
    fi

    # Report only strictly-newer versions
    if (( cmp > 0 )); then
        # shellcheck disable=SC2059
        printf "${MSG[tmpl_update_available]}" \
            "$(pad_to "${MSG[label_update_available]}" "$PAD_VERSION_WIDTH")" \
            "$VERSION" "$remote_ver"
        # shellcheck disable=SC2059
        printf "${MSG[tmpl_release_url]}" \
            "$(pad_to "" "$PAD_VERSION_WIDTH")" "${MSG[help_release_url]}"
        log "[INFO] Update available: local $VERSION, remote v${remote_ver}"
    elif (( cmp == 0 )); then
        # shellcheck disable=SC2059
        printf "  %-20s\n" "${MSG[info_update_latest]}"
        log "[INFO] Update check: current $VERSION equals latest v${remote_ver}."
    else
        log "[INFO] Update check: local $VERSION is ahead of latest v${remote_ver}."
    fi
}



# ───── Log Viewer ─────────────────────────────────────────
# Opens the runtime log with the user's $PAGER (falls back to
# less, then cat) — a read-only convenience verb, deliberately
# outside the backup pipeline.

show_log() {
    show_header
    local newest_archive

    echo "${MSG[info_log_follow_hint]}"
    echo ""

    # Prefer the stable plain log (current or just-finished run)
    if [[ -f "$RUNTIME_LOG" ]]; then
        echo "${MSG[info_log_opening]} $RUNTIME_LOG"
        less +F "$RUNTIME_LOG" 2>/dev/null || tail -f "$RUNTIME_LOG"
    elif compgen -G "$LOG_DIR/*.tar.gz" > /dev/null; then

        # shellcheck disable=SC2012
        newest_archive=$(ls -1t "$LOG_DIR"/*.tar.gz 2>/dev/null | head -n 1)

        # shellcheck disable=SC2012
        echo "${MSG[info_log_archive_opening]} $newest_archive"
        
        tar -xzOf "$newest_archive" | less +F 2>/dev/null || tar -xzOf "$newest_archive"
    else
        echo "${MSG[info_no_log_found]} $LOG_DIR"
        echo "${MSG[info_log_first_run]}"
    fi
    exit 0
}



# ───── Cron Management ────────────────────────────────────
# Cron lines are tagged with the script path so ownership is
# unambiguous: listing, scheduling and unscheduling all filter
# on that marker. A stale lock file or a renamed install is
# tolerated — cron state is advisory, never fatal.

# Membership probe: exits 0 if our marker line sits in the
# active crontab. Read-only, no side effects.

is_cron_scheduled() {
    crontab -l 2>/dev/null | grep -q "$SCRIPT_PATH"
}


# Installs the daily backup line via temp-file rewrite — never
# streams into `crontab -` directly, so a mid-write failure
# cannot truncate the user's existing crontab.

schedule_cron() {
    show_header
    printf "%b%s%b\n" "${FORMATTING_BOLD}" "${MSG[cron_manager]}" "${FORMATTING_RESET}"
    if is_cron_scheduled; then
        info "$(printf "%s\n%s" "${MSG[cron_already]}" "$SCRIPT_PATH")"

        local existing
        
        existing=$(crontab -l 2>/dev/null | grep "$SCRIPT_PATH")
        echo "${MSG[cron_existing]} $existing"
        exit 0
    fi

    local cron_entry

    if [[ "$CRON_INTERVAL_MINUTES" -eq 60 ]]; then
        cron_entry="0 * * * * $SCRIPT_PATH --quiet"
    elif (( CRON_INTERVAL_MINUTES % 60 == 0 )); then
        cron_entry="0 */$(( CRON_INTERVAL_MINUTES / 60 )) * * * $SCRIPT_PATH --quiet"
    else
        cron_entry="*/$CRON_INTERVAL_MINUTES * * * * $SCRIPT_PATH --quiet"
    fi

    (crontab -l 2>/dev/null; echo "$cron_entry") | crontab -

    info "${MSG[cron_scheduled]}"
    echo "  $cron_entry"
    echo ""
    printf "${MSG[tmpl_cron_interval]} %s" "$CRON_INTERVAL_MINUTES"
    echo "${MSG[cron_logs_written]} $RUNTIME_LOG"
    exit 0
}

# Removes exactly our marked line; foreign entries survive the
# rewrite untouched.

unschedule_cron() {
    show_header
    printf "%b%s%b\n" "${FORMATTING_BOLD}" "${MSG[cron_manager]}" "${FORMATTING_RESET}"
    if ! is_cron_scheduled; then
        warn "$(printf "%s\n%s" "${MSG[cron_none_found]}" "$SCRIPT_PATH")"
        exit 0
    fi

    crontab -l 2>/dev/null | grep -v "$SCRIPT_PATH" | crontab -

    info "${MSG[cron_removed]}"
    exit 0
}



# ───── Run Archive: compress previous runs' logs ──────────

# Called at START of a new run. Stable runtime files are packed into
# one timestamped tar.gz, then removed. Archive members keep their
# stable names (runtime.log, transfer.log); only the archive name
# carries the stamp. Empty transfer logs are discarded, not archived.

archive_completed_runs() {
    [[ -e "$RUNTIME_LOG" ]] || return 0

    local stamp
    local -a members archive
    
    stamp="$(date -u '+%Y%m%dT%H%M%SZ')"

    # Empty transfer logs (non-upload runs) are never archived
    if [[ -e "$TRANSFER_LOG" && ! -s "$TRANSFER_LOG" ]]; then
        rm -f "$TRANSFER_LOG"
    fi

    members=(runtime.log)
    [[ -e "$TRANSFER_LOG" ]] && members+=(transfer.log)

    archive="$LOG_DIR/${stamp}.tar.gz"

    if tar -czf "$archive" -C "$LOG_DIR" "${members[@]}" 2>/dev/null; then
        rm -f "$RUNTIME_LOG" "$TRANSFER_LOG"
        log "[INFO] Archived run logs: $(basename "$archive")"
    else
        warn "${MSG[warn_archive_failed]}"
        rm -f "$archive"
    fi
}



# ───── Old Run Pruning ────────────────────────────────────
# Keeps the newest KEEP_RUNS run artifacts and removes the
# rest — bounded retention beats unbounded growth in any
# cron-driven setup. Older runs are never referenced by the
# live database, so pruning is safe mid-cycle.

prune_old_runs() {
    local -a old_archives

    # shellcheck disable=SC2012
    mapfile -t old_archives < <(ls -1t "$LOG_DIR"/*.tar.gz \
                                 2>/dev/null | tail -n +"$(( KEEP_LOG_RUNS + 1 ))")
    [[ ${#old_archives[@]} -eq 0 ]] && return 0
    rm -f "${old_archives[@]}"
    log "[INFO] Pruned ${#old_archives[@]} archived run(s) beyond KEEP_LOG_RUNS."
}



# ───── Dependency Check ───────────────────────────────────
# Fails closed: every required binary (proton-drive CLI, jq,
# numfmt, ...) is probed with -x before a single byte of data
# moves. A missing tool at minute zero costs seconds; the same
# discovery mid-upload costs a partial run.

check_dependencies() {
    local missing=()

    if ! command -v proton-drive &>/dev/null; then
        missing+=("proton-drive")
    fi

    if ! command -v jq &>/dev/null; then
        missing+=("jq")
    fi

    if ! command -v md5sum &>/dev/null; then
        missing+=("md5sum")
    fi

    if ! command -v tar &>/dev/null; then
        missing+=("tar")
    fi

    if ! command -v curl &>/dev/null; then
        missing+=("curl")
    fi

    if [[ ${#missing[@]} -gt 0 ]]; then
        fail "${MSG[fail_dep_missing]} ${missing[*]}"
        echo ""
        echo "  - proton-drive  See https://proton.me/drive/cli"
        echo "  - md5sum        Usually included in coreutils"
        echo "  - jq            apt-get install jq OR dnf install jq OR pacman -S jq"
        echo "  - tar           apt-get install tar OR dnf install tar OR pacman -S tar"
        echo "  - curl          apt-get install curl OR dnf install curl OR pacman -S curl"
        exit 1
    fi

    info "${MSG[info_deps_ok]}"
}



# ───── Load Existing Database ─────────────────────────────

# PREV_MD5_MAP: rel_path → md5 (consumed by compare_and_upload)
# PREV_META_MAP: rel_path → size TAB mtime_epoch TAB mtime_iso
# (consumed by build_local_db as the fast path). Both maps are
# rebuilt from the previous DB copy before every rebuild.

declare -gA PREV_MD5_MAP=()
declare -gA PREV_META_MAP=()

# Fast-path control: --checksum forces full MD5 re-hash
CHECKSUM_ONLY=false



# ───── Argument Parsing ───────────────────────────────────
# Normalizes argv into global flags (VERBOSE, DRY_RUN, RESET_DB,
# ...) with validation here, not later: modes are dispatched
# once in main(), so an invalid combination dies before any
# file system access happens.

parse_args() {
    while [[ $# -gt 0 ]]; do
        case "$1" in
            --help|-h)
                SHOW_HELP=true
                shift
                ;;
            --version|-V)
                SHOW_VERSION=true
                shift
                ;;
            --verbose)
                VERBOSE=true
                RUN_BACKUP=true
                shift
                ;;
            --quiet)
                QUIET_MODE=true
                RUN_BACKUP=true
                shift
                ;;
            --dry-run)
                DRY_RUN=true
                RUN_BACKUP=true
                shift
                ;;
            --reset-db)
                RESET_DB=true
                RUN_BACKUP=true
                shift
                ;;
            --checksum)
                CHECKSUM_ONLY=true
                RUN_BACKUP=true
                shift
                ;;
            --log)
                SHOW_LOG=true
                shift
                ;;
            --schedule)
                SCHEDULE_CRON=true
                shift
                ;;
            --unschedule)
                UNSCHEDULE_CRON=true
                shift
                ;;
            *)
                show_header
                
                warn "${MSG[warn_unknown_option]} $1"

                # shellcheck disable=SC2059
                printf "${MSG[tmpl_usage_hint]}\n" "$SCRIPT_NAME"
                exit 1
                ;;
        esac
    done
}



# ───── Lock File Management ───────────────────────────────
# Locking is advisory via O_EXCL create: the atomic mkdir-class
# guarantee of open()'s exclusive flag makes "two writers, one
# lock file" a race the kernel resolves, not our timing.

# O_EXCL-creates the lock file, refusing to overwrite an
# existing one; records PID and start time so a stale lock
# (crashed run) can be identified instead of guessed at.

acquire_lock() {
    local pid start_time

    pid=$$
    start_time=$(date +%s)

    if [[ -f "$LOCK_FILE" ]]; then
        local existing_pid

        # Read PID only; the stored line is "<pid> <start_time>".
        # Without the discard variable, existing_pid would contain
        # BOTH fields and kill -0 would always fail — silently
        # disabling mutual exclusion.
        read -r existing_pid _ < "$LOCK_FILE" 2>/dev/null || true

        if [[ -n "$existing_pid" ]] && kill -0 "$existing_pid" 2>/dev/null; then
            # shellcheck disable=SC2059
            fail "$(printf "${MSG[tmpl_lock_running]}" "$existing_pid")"
            exit 1
        else
            warn "${MSG[warn_lock_stale]}"
            rm -f "$LOCK_FILE"
        fi
    fi

    echo "$pid $start_time" > "$LOCK_FILE"
    log "[INFO] Lock acquired (PID: $pid)"

    # HUP covers closing the terminal window during a run
    trap 'abort_cleanup; exit 130' INT
    trap 'abort_cleanup; exit 143' TERM
    trap 'abort_cleanup; exit 129' HUP
    trap 'release_lock' EXIT
}


# Removes the lock only if we own it — unconditional rm would
# delete a successor's lock mid-run. Silent on missing file:
# release is idempotent by design.

release_lock() {
    if [[ -f "$LOCK_FILE" ]]; then
        rm -f "$LOCK_FILE"
        log "[INFO] Lock released."
    fi
}



# ───── Session Check ──────────────────────────────────────
# Proves the proton-drive CLI holds a usable token before the
# scan starts — a dead session found here saves a full database
# build that would only fail at the first upload.

ensure_session() {
    info "${MSG[info_session_check]}"

    if proton-drive filesystem list /my-files --json &>/dev/null; then
        success "${MSG[info_session_valid]}"
        return 0
    else
        warn "${MSG[info_auth_required]}"

        echo ""
        echo "  ${MSG[info_login_instruction]} proton-drive auth login"
        echo ""

        if [[ "$DRY_RUN" == "true" ]]; then
            warn "${MSG[warn_dry_run_auth]}"
            return 1
        fi

        if proton-drive auth login; then
            success "${MSG[info_login_success]}"
            return 0
        else
            fail "${MSG[fail_login_failed]}"
            return 1
        fi
    fi
}



# ───── Remote Directory Provisioning ──────────────────────
# Creates the base path explicitly before any subpath, then
# caches successful results in CREATED_REMOTE_DIRS — failure of
# the base was the v1.1 cold-run killer: parentless mkdir on the
# remote API fails, so the base can never be assumed to exist.

ensure_remote_dir() {
    local full_remote_path base subpath

    full_remote_path="$1"

    if [[ -n "${CREATED_REMOTE_DIRS[$full_remote_path]:-}" ]]; then
        return 0
    fi

    base="$REMOTE_BASE_PATH"

    # ── Step 1: ALWAYS establish the base first ──
    # The walk below creates CHILDREN of the base; it assumes
    # the base itself exists. On a fresh remote (or after the
    # old backup was renamed away) it does not — so the base
    # is created here, once per run, regardless of subpath.
    if [[ -z "${CREATED_REMOTE_DIRS[$base]:-}" ]]; then
        local parent name

        parent="/my-files"
        name="${base##*/}"

        if [[ "$DRY_RUN" == "true" ]]; then
            info "[DRY-RUN] ${MSG[info_dry_create_folder]} $base"
        else
            if ! proton-drive filesystem create-folder "$parent" "$name" >/dev/null 2>&1; then
                # Folder may already exist — verify
                if proton-drive filesystem info "$base" >/dev/null 2>&1; then
                    log "[INFO] Remote folder already exists: $base"
                else
                    fail "${MSG[fail_remote_create]} $base"
                    return 1
                fi
            fi
        fi
        CREATED_REMOTE_DIRS["$base"]=1
    fi

    subpath="${full_remote_path#"$base"}"
    subpath="${subpath#/}"

    # Base itself requested — already ensured above
    [[ -z "$subpath" ]] && return 0

    local current

    current="$base"

    IFS='/' read -ra segments <<< "$subpath"
    for seg in "${segments[@]}"; do
        local next

        next="${current}/${seg}"
        if [[ -z "${CREATED_REMOTE_DIRS[$next]:-}" ]]; then
            if [[ "$DRY_RUN" == "true" ]]; then
                info "[DRY-RUN] ${MSG[info_dry_create_folder]} $next"
            else
                if ! proton-drive filesystem create-folder "$current" "$seg" >/dev/null 2>&1; then
                    # Folder may already exist — verify
                    if proton-drive filesystem info "$next" >/dev/null 2>&1; then
                        log "[INFO] Remote folder already exists: $next"
                    else
                        fail "${MSG[fail_remote_create]} $next"
                        return 1
                    fi
                fi
            fi
            CREATED_REMOTE_DIRS["$next"]=1
        fi
        current="$next"
    done
}



# ───── Terminal Resize: one-shot graceful degradation ─────
# A resize invalidates the cached geometry the bar invariant
# depends on (reserved line, cached cols). Rather than re-anchoring
# against unknown reflow behaviour across terminals, the progress
# system is dismantled and the run continues in quiet mode.
# Progress remains fully observable via the transfer/runtime logs.

handle_resize() {
    [[ "$PROGRESS_ENABLED" == "true" ]] || return 0

    PROGRESS_ENABLED=false

    # Release scroll region, then clear the mangled screen for a
    # deterministic output surface for the remainder of the run
    printf "\033[r\033[H\033[2J" >&2

    warn "${MSG[warn_resize_disabled]}"
    warn "${MSG[warn_resize_continuing]}"
    echo -e "          tail -f \"$TRANSFER_LOG\""
}



# ───── Escape Glob Metacharacters ─────────────────────────
# proton-drive CLI performs its own glob expansion on local file paths.
# Characters [ ] ? * { } are interpreted as glob patterns, not literals.
# Workaround: wrap each metacharacter in a character class containing
# only itself (e.g. [ → [[]). This is universally supported by glob
# libraries and does NOT interfere with normal paths.

escape_glob_chars() {
    local s result i char

    s="$1"
    # Fast path: if no glob-special chars, return unchanged
    [[ "$s" == *[\[\]\*\?\{\}]* ]] || { printf '%s' "$s"; return; }

    result=""

    for ((i = 0; i < ${#s}; i++)); do
        char="${s:i:1}"
        case "$char" in
            '[') result+='[[]' ;;
            ']') result+='[]]' ;;
            '?') result+='[?]' ;;
            '*') result+='[*]' ;;
            '{') result+='[{]' ;;
            '}') result+='[}]' ;;
            *)   result+="$char" ;;
        esac
    done
    printf '%s' "$result"
}



# ───── Local Database Building ────────────────────────────
# Builds the STAGING database (NEW_DB_PATH) from disk reality:
# enumerates, stats and hashes every file, reusing stored MD5s
# via the fast path (size + mtime unchanged). The authoritative
# DB is never touched here — commit_db() promotes the staging
# file only after all phases confirm.

build_local_db() {
    info "${MSG[info_building_db]}:"
    log "[INFO] Starting database build."

    local file_count total_size total_files src_dir fast_reused

    file_count=0
    total_size=0
    fast_reused=0

    # ── Pass 1: pre-count files (metadata traversal only, no hashing) ──
    total_files=0

    for src_dir in "${SOURCE_DIRS[@]}"; do
        [[ -d "$src_dir" ]] || continue
        local n

        n=$(find "$src_dir" -type f -not -type l -print 2>/dev/null | wc -l)
        total_files=$(( total_files + n ))
    done
    log "[INFO] File pre-count for progress display: $total_files files."

    local tmp_entries tmp_edge tmp_output

    tmp_entries=$(mktemp) || { fail "Cannot create temp file for database build."; exit 1; }
    tmp_edge=$(mktemp) || { fail "Cannot create temp file for edge-case entries."; rm -f "$tmp_entries"; exit 1; }

    for src_dir in "${SOURCE_DIRS[@]}"; do
        if [[ ! -d "$src_dir" ]]; then
            warn "${MSG[warn_skip_missing_dir]} $src_dir"
            continue
        fi

        proc "${MSG[label_scan]} $src_dir..."
        
        # Anchor the bar from the very start of the phase
        progress_anchor

        while IFS= read -r -d '' file; do

            local rel_base rel_path checksum file_size file_mtime_epoch file_mtime

            checksum=""

            rel_base="${src_dir#"$SOURCE_BASE"/}"
            rel_path="${rel_base}/${file#"$src_dir"/}"
            rel_path="${rel_path#/}"

            if ! meta=$(stat -c '%s %Y' "$file" 2>/dev/null); then
                warn "${MSG[warn_file_unreadable]} $file"
                continue
            fi

            read -r file_size file_mtime_epoch <<< "$meta"

            # ── Fast path: size + mtime unchanged → reuse MD5 ──
            if [[ "$CHECKSUM_ONLY" != "true" && -n "${PREV_META_MAP[$rel_path]:-}" ]]; then
                local p_size p_mtime_epoch p_mtime_iso

                IFS=$'\t' read -r p_size p_mtime_epoch p_mtime_iso \
                    <<< "${PREV_META_MAP[$rel_path]}"

                if [[ "$p_size" == "$file_size" && "$p_mtime_epoch" == "$file_mtime_epoch" ]] \
                    && [[ -n "${PREV_MD5_MAP[$rel_path]:-}" ]]; then
                    checksum="${PREV_MD5_MAP[$rel_path]}"
                    file_mtime="$p_mtime_iso"
                    fast_reused=$((fast_reused + 1))
                fi
            fi

            # ── Slow path: full hash for new or changed files ──
            if [[ -z "$checksum" ]]; then
                checksum=$(md5sum "$file" 2>/dev/null | awk '{print $1}') || {
                    warn "${MSG[warn_file_unreadable]} $file"
                    continue
                }

                # shellcheck disable=SC2034
                file_mtime=$(date -u -d "@$file_mtime_epoch" '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null) \
                    || file_mtime="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
            fi

            # ── TSV collection (fast path for the common case) ──
            if [[ "$file" == *$'\x1f'* || "$file" == *$'\n'* || "$file" == *$'\t'* ]]; then
                jq -nc --arg lp "$file" --arg rp "$rel_path" --arg md5 "$checksum" \
                    --argjson sz "$file_size" --argjson me "$file_mtime_epoch" \
                    '{local_path: $lp, relative_path: $rp, md5: $md5,
                      size_bytes: $sz, mtime_epoch: $me}' >> "$tmp_edge"
            else
                printf '%s\x1f%s\x1f%s\x1f%s\x1f%s\n' \
                    "$file" "$rel_path" "$checksum" "$file_size" "$file_mtime_epoch" \
                    >> "$tmp_entries"
            fi

            file_count=$((file_count + 1))
            total_size=$((total_size + file_size))

            # Unified progress update — every file in VERBOSE mode
            if [[ "$VERBOSE" == "true" ]]; then
                show_progress_bar "$file_count" "$total_files" "$total_size" "${MSG[label_scan]}"
            fi
        done < <(find "$src_dir" -type f -not -type l -print0 2>/dev/null)
    done

    if [[ "$file_count" -eq 0 ]]; then
        warn "$(printf '%s\n         %s' "${MSG[warn_db_empty]}" " ${CONFIG_FILE}")"
    fi

    local srcdirs_json tmp_output human_size
    
    srcdirs_json=$(printf '%s\n' "${SOURCE_DIRS[@]}" | jq -R . | jq -s '.')
    tmp_output=$(mktemp) || { fail "Cannot create temp file for output."; rm -f "$tmp_entries" "$tmp_edge" "${tmp_entries}.json"; exit 1; }

    # ── Single-shot conversion: collected TSV → JSON entries ──
    # shellcheck disable=SC2034
    jq -R -s '
        (if . == "" then "[]" else
          rtrimstr("\n") | split("\n")
          | map(split("\u001f"))
          | map({ local_path: .[0],
                  relative_path: .[1],
                  md5: .[2],
                  size_bytes: (.[3] | tonumber),
                  mtime_epoch: (.[4] | tonumber),
                  mtime: ((.[4] | tonumber) | todate) })
        end)' "$tmp_entries" > "${tmp_entries}.json" \
        && tmp_json_entries="${tmp_entries}.json"

    srcdirs_json=$(printf '%s\n' "${SOURCE_DIRS[@]}" | jq -R . | jq -s '.')
    tmp_output=$(mktemp) || {
        fail "Cannot create temp file for output."
        rm -f "$tmp_entries" "$tmp_edge" "${tmp_entries}.json"
        exit 1
    }

    # ── Final wrapper: header + main entries + edge-case entries ──
    if [[ -s "${tmp_entries}.json" ]]; then
        jq -n \
            --arg ver "1.0" \
            --arg created "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
            --arg modified "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
            --slurpfile entries "${tmp_entries}.json" \
            --argjson srcdirs "$srcdirs_json" \
            --arg rbp "$REMOTE_BASE_PATH" \
            '{version: $ver, created_at: $created, last_modified: $modified,
              entries: ($entries[0] + [inputs]), source_dirs: $srcdirs, remote_base: $rbp}' \
            < <(cat /dev/null "$tmp_edge") > "$tmp_output"
    else
        jq -n \
            --arg ver "1.0" \
            --arg created "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
            --arg modified "$(date -u '+%Y-%m-%dT%H:%M:%SZ')" \
            --argjson srcdirs "$srcdirs_json" \
            --arg rbp "$REMOTE_BASE_PATH" \
            '{version: $ver, created_at: $created, last_modified: $modified,
              entries: [inputs], source_dirs: $srcdirs, remote_base: $rbp}' \
            < <(cat /dev/null "$tmp_edge") > "$tmp_output"
    fi

    # ── Staging only — commit_db() will finalize later ──────
    NEW_DB_PATH=$(mktemp) || {
        fail "Cannot create staging file for database build."
        rm -f "$tmp_entries" "$tmp_edge" "${tmp_entries}.json" "$tmp_output"
        exit 1
    }

    mv "$tmp_output" "$NEW_DB_PATH" || {
        rm -f "$tmp_entries" "$tmp_edge" "${tmp_entries}.json" "$tmp_output" "$NEW_DB_PATH"
        fail "Failed to move staging database."
        exit 1
    }
    rm -f "$tmp_entries" "$tmp_edge" "${tmp_entries}.json" "$tmp_output"

    # Console gets human-readable size; the log below keeps raw
    # bytes (grep- and diff-friendly for automated consumption).
    human_size=$(numfmt --to=iec-i --suffix=B "$total_size" 2>/dev/null) \
        || human_size="${total_size}B"

    # shellcheck disable=SC2059
    info "$(printf "${MSG[tmpl_db_built]}" "$file_count" "$human_size")"
    log "[INFO] Fast path reused stored MD5 for $fast_reused of $file_count files ($(( fast_reused * 100 / (file_count > 0 ? file_count : 1) ))%), $total_size bytes."

    # Final state visibility (once per phase, not per file)
    if [[ "$VERBOSE" == "true" ]]; then
        show_progress_bar "$file_count" "$total_files" "$total_size" "${MSG[label_scan]}"
        sleep 1         # brief final state visibility
    fi
}



# ───── Load Existing Database ─────────────────────────────
# Loads the previous run's DB into lookup maps BEFORE the
# rebuild consumes them; three cases resolve to /dev/null
# (first run, --reset-db, remote-base mismatch), which all
# degrade gracefully to a full upload.

load_local_db() {
    # Fresh maps for every run — leftovers from a previous source
    # would fabricate fast-path hits and skip real changes.
    PREV_MD5_MAP=()
    PREV_META_MAP=()

    if [[ "$RESET_DB" == "true" ]]; then
        warn "${MSG[warn_rebuild_db]}"
        PREVIOUS_DB_PATH="/dev/null"
        build_local_db
        log "[INFO] Previous DB discarded (--reset-db); 0 entries loaded."
        return 0
    fi

    if [[ ! -f "$CHECKSUM_DB" ]]; then
        info "${MSG[info_no_db_found]}"
        PREVIOUS_DB_PATH="/dev/null"
        build_local_db
        return 0
    fi

    # Copy previous DB to a TEMP FILE before rebuilding.
    local prev_tmp prev_count loaded

    prev_tmp=$(mktemp) || { fail "Cannot create temp file for previous DB."; exit 1; }
    cp "$CHECKSUM_DB" "$prev_tmp"
    PREVIOUS_DB_PATH="$prev_tmp"

    prev_count=$(jq '.entries | length' "$PREVIOUS_DB_PATH" 2>/dev/null) || prev_count=0

    # ── Build BOTH lookup maps BEFORE the rebuild ──
    # build_local_db() consumes PREV_META_MAP as its fast path
    # (size + mtime match → reuse the stored MD5 instead of
    # re-hashing), so the maps must be populated before the call.
    # PREV_META_MAP stays empty on first runs and with --checksum —
    # the fast path then degrades to the full-hash path by itself.
    loaded=0

    if [[ "$VERBOSE" == "true" && "$prev_count" -gt 0 && "$CHECKSUM_ONLY" != "true" ]]; then
        info "${MSG[info_lookup_build]}"
        show_progress_bar 0 "$prev_count" 0 "${MSG[label_load]}"
    fi

    while IFS=$'\t' read -r path md5 size mtime_epoch mtime_iso; do
        [[ -n "$path" ]] || continue
        PREV_MD5_MAP["$path"]="$md5"
        PREV_META_MAP["$path"]="${size}"$'\t'"${mtime_epoch}"$'\t'"${mtime_iso}"
        loaded=$((loaded + 1))
        if [[ "$VERBOSE" == "true" ]] && (( loaded % 5000 == 0 )); then
            show_progress_bar "$loaded" "$prev_count" 0 "${MSG[label_load]}"
        fi
    done < <(jq -r '.entries[] | [.relative_path, .md5, (.size_bytes|tostring),
                   (.mtime_epoch // (.mtime | fromdateiso8601? // 0) | tostring),
                   (.mtime // 0)] | @tsv' \
                   "$PREVIOUS_DB_PATH" 2>/dev/null)

    # Rebuild current DB — fast path active via PREV_META_MAP
    # (previous is safe in $prev_tmp; compare_and_delete reads it)
    build_local_db

    # shellcheck disable=SC2059
    info "$(printf "${MSG[tmpl_prev_db_loaded]}" "$prev_count")"
    log "[INFO] Previous DB loaded ($prev_count entries); current DB rebuilt."

    # Final state visibility (once per phase, not per file)
    if [[ "$VERBOSE" == "true" ]]; then
        show_progress_bar "$loaded" "$prev_count" 0 "${MSG[label_load]}"
        sleep 1         # brief final state visibility
    fi

    log "[INFO] Loaded $loaded entries into lookup tables."
}


# ───── Retry Queue ────────────────────────────────────────
# Persistent record of uploads never confirmed on the
# remote. build_local_db() stores the CURRENT local MD5
# regardless of upload outcome — a failed upload would
# otherwise silently pass the MD5 skip check of the next
# run (integrity gap). Queue membership therefore outranks
# the skip check: entries are consulted BEFORE the regular
# pass decides anything.
#
# File format (TSV, one line per file):
#   relative_path <TAB> attempts <TAB> first_seen_utc <TAB> last_error
#
# attempts is CUMULATIVE across runs (persists over crashes
# and restarts). A run retries an entry only while
# attempts < RETRY_MAX_ATTEMPTS. Entries are removed on
# confirmed success or when the local file no longer
# exists; they never expire, never decay silently.
#
# --dry-run contract: the queue is read and reported, but
# no writes occur (no appends, no removals, no attempt
# consumption) — symmetric to hypothetical folder output.

RETRY_FILE="$CONFIG_DIR/$SCRIPT_NAME.retry"

declare -gA RETRY_QUEUE=()          # rel_path → attempts<TAB>first_seen<TAB>last_error
declare -gA CONFIRMED_THIS_RUN=()   # rel_path → 1 (retry-prepass upload success)

RETRIED_COUNT=0
RETRY_PENDING_COUNT=0

capture_cli_error() {
    local msg
    msg=$(head -3 "$TMP_ERR_FILE" 2>/dev/null | tr '\n' ' ')
    printf '%s' "${msg:-unknown error}"
}



# ── Shared upload primitive ─────────────────────────────
# Single upload attempt, consumed by BOTH the retry
# pre-pass and the regular upload pass. Counters,
# dry-run simulation, and user-visible messages remain
# with the CALLER — this function only performs the work
# and reports the outcome.
#
# Args:  $1 = rel_path, $2 = local_path
# Returns:
#   0 = upload confirmed
#   1 = upload failed  (CLI stderr captured in $TMP_ERR_FILE)
#   2 = remote directory creation failed
#
# Preconditions:
#   - fd 3 open (transfer log or /dev/null — caller's duty)
#   - real run only (--dry-run callers simulate elsewhere)

upload_single_file() {
    local rel_path="$1" local_path="$2"
    local dir_part upload_dest safe_path

    dir_part=$(dirname "$rel_path")

    if [[ "$dir_part" == "." ]]; then
        upload_dest="$REMOTE_BASE_PATH"
    else
        upload_dest="${REMOTE_BASE_PATH}/${dir_part}"
        if ! ensure_remote_dir "$upload_dest"; then
            return 2
        fi
    fi

    safe_path=$(escape_glob_chars "$local_path")

    set -f

    if proton-drive filesystem upload "$safe_path" "$upload_dest" \
        -f "$UPLOAD_CONFLICT_STRATEGY" ${UPLOAD_SKIP_THUMBNAILS} >&3 2>"$TMP_ERR_FILE"; then
        set +f
        return 0
    fi

    set +f
    return 1
}


# ── Load the persistent queue into the in-memory map ──
# Fresh map per run: leftover entries from a previous
# source would fabricate retry candidates.

retry_queue_load() {
    RETRY_QUEUE=()

    [[ -f "$RETRY_FILE" ]] || return 0

    local path attempts first_seen last_error

    while IFS=$'\t' read -r path attempts first_seen last_error; do
        [[ -n "$path" ]] || continue
        # Defaults tolerate truncated lines from an old crash:
        # the entry must survive parsing, never vanish silently
        RETRY_QUEUE["$path"]="${attempts:-1}"$'\t'"${first_seen:-}"$'\t'"${last_error:-}"
    done < "$RETRY_FILE"

    log "[INFO] Retry queue loaded: ${#RETRY_QUEUE[@]} entries."
}


# ── Atomic full rewrite of the queue file from the map ──
# Failures are rare by nature (28 in 4 days), so an
# O(entries) rewrite per event is cheap — and it keeps the
# file and the map in lockstep at every observable instant.
# mktemp + mv follows the atomicity pattern of build_local_db.

retry_queue_persist() {
    local tmp_queue path

    if (( ${#RETRY_QUEUE[@]} == 0 )); then
        # Empty queue leaves no orphan file behind
        rm -f "$RETRY_FILE"
        return 0
    fi

    tmp_queue=$(mktemp) || { fail "Cannot create temp file for retry queue."; return 1; }

    for path in "${!RETRY_QUEUE[@]}"; do
        printf '%s\t%s\n' "$path" "${RETRY_QUEUE[$path]}"
    done > "$tmp_queue"

    if ! mv "$tmp_queue" "$RETRY_FILE"; then
        rm -f "$tmp_queue"
        fail "Failed to persist retry queue."
        return 1
    fi
}


# ── Record a failed upload attempt ──
# Increments the cumulative attempt counter, stamps the
# first failure, and persists IMMEDIATELY — an entry must
# survive SIGKILL at any point after the failed upload.

retry_queue_record_failure() {
    local rel_path="$1" err_msg="$2"
    local record attempts first_seen

    [[ "$DRY_RUN" == "true" ]] && return 0

    # TSV safety: tabs/newlines in the error message would
    # corrupt the column layout of every following line
    err_msg=$(printf '%s' "$err_msg" | tr '\t\n' '  ')

    record="${RETRY_QUEUE[$rel_path]:-}"

    if [[ -n "$record" ]]; then
        IFS=$'\t' read -r attempts first_seen _ <<< "$record"
        attempts=$(( attempts + 1 ))
    else
        attempts=1
        first_seen="$(date -u '+%Y-%m-%dT%H:%M:%SZ')"
    fi

    RETRY_QUEUE["$rel_path"]="${attempts}"$'\t'"${first_seen}"$'\t'"${err_msg}"

    retry_queue_persist
}


# ── Remove an entry after confirmed upload success ──

retry_queue_remove() {
    local rel_path="$1"

    [[ "$DRY_RUN" == "true" ]] && return 0

    unset "RETRY_QUEUE[$rel_path]"

    retry_queue_persist
}


# ── Eligibility check ──
# an entry earns a retry attempt in this run only while its
# cumulative counter is below the configured ceiling

retry_queue_eligible() {
    local record attempts

    record="${RETRY_QUEUE[$1]:-}"
    [[ -z "$record" ]] && return 1

    attempts="${record%%$'\t'*}"
    (( attempts < RETRY_MAX_ATTEMPTS ))
}


# ── Retry pre-pass ─────────────────────────────────────
# Before the regular MD5 skip check runs, every eligible
# queue entry is retried ONCE per run. Entries exceeding
# the attempt ceiling → remain pending for next run.
# Success removes entry AND sets CONFIRMED_THIS_RUN[$path]=1.
#
# --dry-run: queue entries are reported but no uploads
# occur. Attempts are NOT consumed, queue file untouched.

retry_queue_process() {
    local path record attempts first_seen last_error
    local eligible_count pending_after attempted
    local local_path err_msg

    eligible_count=0
    pending_after=0
    attempted=0

    # Build reverse map: relative_path → local_path from current DB
    declare -gA LOCAL_PATH_MAP=()
    while IFS=$'\t' read -r rel_path loc_path; do
        [[ -n "$rel_path" ]] || continue
        LOCAL_PATH_MAP["$rel_path"]="$loc_path"
    done < <(jq -r '.entries[] | [.relative_path, .local_path] | @tsv' \
                  "$NEW_DB_PATH" 2>/dev/null)

    log "[INFO] Built local path lookup map for ${#LOCAL_PATH_MAP[@]} entries."

    # ── Pre-count eligible entries for a stable bar denominator ──
    # The bar must not gain total mid-loop; eligibility is the only
    # criterion here — missing local files are handled (and counted
    # down implicitly) in the main loop.
    for path in "${!RETRY_QUEUE[@]}"; do
        if retry_queue_eligible "$path" \
            && [[ -n "${LOCAL_PATH_MAP[$path]:-}" ]] \
            && [[ -f "${LOCAL_PATH_MAP[$path]}" ]]; then
            eligible_count=$((eligible_count + 1))
        fi
    done

    # Phase anchor for progress bar
    [[ "$VERBOSE" == "true" ]] && show_progress_bar 0 "$eligible_count" 0 "${MSG[label_retry]}"

    for path in "${!RETRY_QUEUE[@]}"; do
        record="${RETRY_QUEUE[$path]}"
        IFS=$'\t' read -r attempts first_seen last_error <<< "$record"

        # Dry-run
        if [[ "$DRY_RUN" == "true" ]]; then
            detail_info "[DRY-RUN] Would retry: $path (attempts: $attempts)"
            continue
        fi

        # Local file must still exist to retry
        local_path="${LOCAL_PATH_MAP[$path]:-}"
        if [[ -z "$local_path" ]] || [[ ! -f "$local_path" ]]; then
            detail_warn "  Local file missing (removing from queue): $path"
            retry_queue_remove "$path"
            pending_after=$((pending_after + 1))
            continue
        fi

        # Eligibility check
        if ! retry_queue_eligible "$path"; then
            pending_after=$((pending_after + 1))
            log "[INFO] Entry exhausted (attempts: $attempts): $path"
            continue
        fi

        # Backoff between rounds: only when attempts > 1
        if (( attempts > 1 )); then
            local backoff=$(( RETRY_BACKOFF_BASE ** (attempts - 1) ))
            log "[INFO] Backoff ${backoff}s before retry for: $path"
            sleep "$backoff"
        fi

        attempted=$((attempted + 1))

        # Attempt upload — direct invocation in parent shell,
        # preserves the CREATED_REMOTE_DIRS cache across calls
        upload_single_file "$path" "$local_path"; rc=$?
        case "$rc" in
            0)
                RETRIED_COUNT=$((RETRIED_COUNT + 1))
                CONFIRMED_THIS_RUN["$path"]=1
                retry_queue_remove "$path"
                UPLOAD_BYTES=$((UPLOAD_BYTES + $(stat -c%s "$local_path" 2>/dev/null || echo 0)))
                detail_success "  Retried successfully: $path"
                log "[INFO] Retry success: $path"
                ;;
            1)
                err_msg=$(capture_cli_error)
                detail_fail "  Retry failed: $path ($err_msg)"
                log "[ERROR] Retry failed for: $path (attempt $attempts) — $err_msg"
                ERROR_COUNT=$((ERROR_COUNT + 1))
                retry_queue_record_failure "$path" "$err_msg"
                ;;
            2)
                err_msg="Remote directory creation failed"
                detail_fail "  Cannot create remote directory for: $path"
                log "[ERROR] Remote directory creation failed for: $path"
                ERROR_COUNT=$((ERROR_COUNT + 1))
                retry_queue_record_failure "$path" "$err_msg"
                ;;
        esac

        # Progress update — every attempt moves the bar
        if [[ "$VERBOSE" == "true" ]]; then
            show_progress_bar "$attempted" "$eligible_count" 0 "${MSG[label_retry]}"
        fi
    done

    # Finalize progress and final state visibility (once per phase, not per file)
    if [[ "$VERBOSE" == "true" ]]; then
        show_progress_bar "$attempted" "$eligible_count" 0 "${MSG[label_retry]}"
        sleep 1         # brief final state visibility
    fi

    # RETRY_PENDING_COUNT used in print_summary()
    # shellcheck disable=2034
    RETRY_PENDING_COUNT=${#RETRY_QUEUE[@]}

    log "[INFO] Retry pre-pass: $eligible_count eligible, $RETRIED_COUNT succeeded, $pending_after still pending."
}



# ── Database commit point ───────────────────────────────
# The staging DB replaces the authoritative checksum DB
# only AFTER upload and delete phases confirmed transfers.
# A crash anywhere earlier leaves the old DB in place — the
# next run re-detects and re-uploads (harmless duplicates
# under "replace"); it can never assert transfers that never
# happened. Complementary to the retry queue: the queue
# covers upload ERRORS in intact runs, the commit point
# covers process DEATH at any instant.
#
# --dry-run: the staging DB is discarded; the authoritative
# DB is never written in simulation mode.

commit_db() {
    [[ -n "$NEW_DB_PATH" && -f "$NEW_DB_PATH" ]] || return 0

    if [[ "$DRY_RUN" == "true" ]]; then
        log "[INFO] Dry-run: staging database discarded, checksum DB untouched."
        rm -f "$NEW_DB_PATH"
        NEW_DB_PATH=""
        return 0
    fi

    if mv "$NEW_DB_PATH" "$CHECKSUM_DB"; then
        NEW_DB_PATH=""
        log "[INFO] Checksum database committed after confirmed phases."
    else
        fail "Failed to commit checksum database (mv failed)."
        return 1
    fi
}



# ───── Compare and Upload ─────────────────────────────────
# The heart of the delta logic: uploads only files whose MD5
# differs from the previous DB (or that the retry pre-pass
# confirmed this run). Failures route into the retry queue
# instead of the old dead-end error log.

compare_and_upload() {
    # Conditional message based on whether a previous DB exists
    if [[ "$PREVIOUS_DB_PATH" == "/dev/null" ]]; then
        info "${MSG[info_compare_upload_new]}"
    else
        info "${MSG[info_compare_upload]}"
    fi
    log "[INFO] Upload comparison phase started."

    local local_entries err_msg
    
    local_entries=$(jq -c '.entries[]' "$NEW_DB_PATH" 2>/dev/null) || true

    if [[ -z "$local_entries" ]]; then
        info "${MSG[info_no_local_files]}"
        return 0
    fi

    local total_to_process seen seen_bytes
    
    total_to_process=$(echo "$local_entries" | wc -l)

    # Unified counter: every file this phase processes (skip AND upload)
    seen=0
    seen_bytes=0
    
    if [[ "$VERBOSE" == "true" ]]; then
        show_progress_bar 0 "$total_to_process" 0 "${MSG[label_process]}"
    fi
    
    # Anchor the bar from the very start of the phase
    progress_anchor

    while IFS= read -r entry; do
        [[ -z "$entry" ]] && continue

        local local_path rel_path md5 fsize

        local_path=$(echo "$entry" | jq -r '.local_path')
        rel_path=$(echo "$entry" | jq -r '.relative_path')
        md5=$(echo "$entry" | jq -r '.md5')

        seen=$((seen + 1))
         
        fsize=$(stat -c%s "$local_path" 2>/dev/null) || fsize=0
        seen_bytes=$((seen_bytes + fsize))

        if [[ ! -f "$local_path" ]]; then
            detail_warn "  File no longer exists (skipping): $rel_path"
            WARNING_COUNT=$((WARNING_COUNT + 1))
        else
            local prev_md5

            prev_md5="${PREV_MD5_MAP[$rel_path]:-}"

            # Queue confirmation outranks MD5 equality: a file
            # successfully replayed by the retry pre-pass must
            # not be uploaded a second time by the regular pass
            if [[ -n "$prev_md5" && "$prev_md5" == "$md5" ]] \
                || [[ -n "${CONFIRMED_THIS_RUN[$rel_path]:-}" ]]; then
                SKIP_COUNT=$((SKIP_COUNT + 1))
                detail_info "Skip (unchanged): $rel_path"
            else
                local dir_part upload_dest
                
                dir_part=$(dirname "$rel_path")

                if [[ "$dir_part" == "." ]]; then
                    upload_dest="$REMOTE_BASE_PATH"
                else
                    upload_dest="${REMOTE_BASE_PATH}/${dir_part}"
                fi

                if [[ "$DRY_RUN" == "true" ]]; then
                    detail_info "[DRY-RUN] Would upload: $rel_path"
                    UPLOAD_COUNT=$((UPLOAD_COUNT + 1))
                else
                    # Direct invocation in parent shell — preserves CREATED_REMOTE_DIRS cache
                    upload_single_file "$rel_path" "$local_path"; rc=$?
                    case "$rc" in
                        0)
                            UPLOAD_COUNT=$((UPLOAD_COUNT + 1))
                            UPLOAD_BYTES=$((UPLOAD_BYTES + fsize))
                            detail_success "  ${MSG[info_uploaded]} $rel_path"
                            ;;
                        1)
                            err_msg=$(capture_cli_error)
                            detail_fail "  Upload failed: $rel_path ($err_msg)"
                            log "[ERROR] Upload failed for: $local_path — $err_msg"
                            ERROR_COUNT=$((ERROR_COUNT + 1))
                            retry_queue_record_failure "$rel_path" "$err_msg"
                            ;;
                        2)
                            err_msg="Remote directory creation failed"
                            detail_fail "  Cannot create remote directory for: $rel_path"
                            log "[ERROR] Remote directory creation failed for: $rel_path"
                            ERROR_COUNT=$((ERROR_COUNT + 1))
                            retry_queue_record_failure "$rel_path" "$err_msg"
                            ;;
                    esac
                fi
            fi
        fi

        # Unified progress update — every file in VERBOSE mode
        if [[ "$VERBOSE" == "true" ]]; then
            show_progress_bar "$seen" "$total_to_process" "$seen_bytes" "${MSG[label_process]}"
        fi
    done <<< "$local_entries"

    # Final state visibility (once per phase, not per file)
    if [[ "$VERBOSE" == "true" ]]; then
        show_progress_bar "$seen" "$total_to_process" "$seen_bytes" "${MSG[label_process]}"
        sleep 1         # brief final state visibility
    fi

    exec 3>&-

    # ── Consolidated phase summary: one sentence for console and log ──
    local human_bytes
    human_bytes=$(numfmt --to=iec-i --suffix=B "$UPLOAD_BYTES" 2>/dev/null) \
        || human_bytes="${UPLOAD_BYTES}B"

    # shellcheck disable=SC2059
    info "$(printf "${MSG[tmpl_upload_phase]}" "$UPLOAD_COUNT" "$SKIP_COUNT" "$human_bytes")"
    log "[INFO] Upload phase complete: $UPLOAD_COUNT uploaded, $SKIP_COUNT skipped, $UPLOAD_BYTES bytes."
}



# ───── Compare and Delete ─────────────────────────────────
# Computes the set difference previous minus current (comm on
# sorted unique paths) — the resulting orphans are trashed or
# permanently deleted per DELETE_MODE. Deletion is two-step on
# purpose: trash first, then delete from trash.

compare_and_delete() {
    info "${MSG[info_compare_delete]}"
    log "[INFO] Delete comparison phase started."

    local prev_paths_file curr_paths_file orphan_count

    prev_paths_file=$(mktemp) || { fail "Cannot create temp file."; return 1; }
    jq -r '.entries[].relative_path' "$PREVIOUS_DB_PATH" 2>/dev/null \
        | sort -u > "$prev_paths_file"

    curr_paths_file=$(mktemp) || { fail "Cannot create temp file."; \
        rm -f "$prev_paths_file"; return 1; }
    jq -r '.entries[].relative_path' "$NEW_DB_PATH" 2>/dev/null \
        | sort -u > "$curr_paths_file"

    orphan_count=$(comm -23 "$prev_paths_file" "$curr_paths_file" | wc -l)

    if [[ "$orphan_count" -eq 0 ]]; then
        info "${MSG[info_no_orphans]}"
        rm -f "$prev_paths_file" "$curr_paths_file"
        return 0
    fi

    # Anchor the bar from the very start of the phase
    progress_anchor

    if [[ "$VERBOSE" == "true" ]]; then
        show_progress_bar 0 "$orphan_count" 0 "${MSG[label_delete]}"
    fi

    local processed

    processed=0
    
    while IFS= read -r prev_rel; do
        [[ -z "$prev_rel" ]] && continue

        processed=$((processed + 1))

        local remote_path err_msg

        remote_path="${REMOTE_BASE_PATH}/${prev_rel}"

        if [[ "$DRY_RUN" == "true" ]]; then
            detail_warn "[DRY-RUN] Would $DELETE_MODE: $remote_path"
        else
            if [[ "$DELETE_MODE" == "delete" ]]; then
                # Permanent deletion requires Proton Drive's two-step:
                # trash first, then delete by its trash path.
                if ! proton-drive filesystem trash "$remote_path" \
                    >/dev/null 2>"$TMP_ERR_FILE"; then
                    err_msg=$(head -3 "$TMP_ERR_FILE" 2>/dev/null | tr '\n' ' ')
                    err_msg="${err_msg:-unknown error}"
                    detail_fail "  trash failed: $remote_path"
                    log "[ERROR] trash (pre-delete step) failed for: $remote_path — $err_msg"
                    ERROR_COUNT=$((ERROR_COUNT + 1))
                    continue
                fi

                local trash_target

                trash_target="/trash/$(basename "$remote_path")"

                if proton-drive filesystem delete "$trash_target" \
                    >/dev/null 2>"$TMP_ERR_FILE"; then
                    DELETE_COUNT=$((DELETE_COUNT + 1))
                    detail_success "  Permanently deleted (after trash): $remote_path"
                    log "[INFO] Permanently deleted: $remote_path"
                else
                    err_msg=$(head -3 "$TMP_ERR_FILE" 2>/dev/null | tr '\n' ' ')
                    err_msg="${err_msg:-unknown error}"
                    detail_fail "  delete failed: $trash_target (origin: $remote_path)"
                    log "[ERROR] delete failed for: $remote_path — trash path was: $trash_target — $err_msg"
                    ERROR_COUNT=$((ERROR_COUNT + 1))
                fi
            else
                # trash mode: single step, recoverable
                if proton-drive filesystem trash "$remote_path" \
                    >/dev/null 2>"$TMP_ERR_FILE"; then
                    DELETE_COUNT=$((DELETE_COUNT + 1))
                    detail_success "Trashed (orphan): $remote_path"
                    log "[INFO] Trashed orphaned remote file: $remote_path"
                elif ! proton-drive filesystem info "$remote_path" &>/dev/null; then
                    # Node already absent on remote — benign, not an error
                    detail_info "  Already absent on remote (skipping): $remote_path"
                    log "[INFO] Orphan not present on remote: $remote_path"
                else
                    err_msg=$(head -3 "$TMP_ERR_FILE" 2>/dev/null | tr '\n' ' ')
                    err_msg="${err_msg:-unknown error}"
                    detail_fail "- trash failed: $remote_path"
                    log "[ERROR] trash failed for: $remote_path — $err_msg"
                    ERROR_COUNT=$((ERROR_COUNT + 1))
                fi
            fi
        fi

        # Progress bar (verbose only) — every orphan processed:
        # delete iterations cost API roundtrips per item, staged
        # intervals froze the bar for thousands of iterations
        if [[ "$VERBOSE" == "true" ]]; then
            show_progress_bar "$processed" "$orphan_count" 0 "${MSG[label_delete]}"
        fi
    done < <(comm -23 "$prev_paths_file" "$curr_paths_file")

    # Final state visibility (once per phase, not per file)
    if [[ "$VERBOSE" == "true" ]]; then
        show_progress_bar "$processed" "$orphan_count" 0 "${MSG[label_delete]}"
        sleep 1
    fi

    rm -f "$prev_paths_file" "$curr_paths_file"

    # shellcheck disable=SC2059
    info "$(printf "${MSG[tmpl_delete_phase]}" "$DELETE_COUNT" "${MSG[mode_verb_${DELETE_MODE}]}")"
}



# ───── Progress Bar Helpers ───────────────────────────────
# A scroll region confines all regular output to the lines
# above; the LAST terminal line is permanently reserved for
# the progress bar and can never be scrolled onto. Per-file
# detail messages are log-only (see detail_* functions).
# Disabled automatically when stderr is not a terminal
# (pipes, cron, redirection).

PROGRESS_ENABLED=false
PROGRESS_DREW=false    # true once any bar was actually drawn
PROGRESS_LINES=0
PROGRESS_COLS=80
PROGRESS_START_EPOCH=0
PROGRESS_PHASE_EPOCH=0


# ───── Progress indicator bar ─────────────────────────────
# Sets the per-phase reference time for ETA calculation.
# Each phase (load, scan, upload, delete) anchors itself
# right before its processing loop — ETAs therefore measure
# only their own workload, never distorted by preceding
# phases. Called exactly once per phase.

progress_anchor() {
    PROGRESS_PHASE_EPOCH=$(date +%s)
}


progress_init() {
    # --quiet is an output contract (warnings + summary only), not
    # merely disabled rendering: no scroll region, no bridge line,
    # no WINCH trap — nothing TUI-related is ever set up.
    [[ "$QUIET_MODE" == "true" ]] && return 0

    [[ -t 2 ]] || return 0
    PROGRESS_START_EPOCH=$(date +%s)
    PROGRESS_PHASE_EPOCH=$PROGRESS_START_EPOCH
    PROGRESS_LINES=$(tput lines 2>/dev/null) || PROGRESS_LINES=24
    PROGRESS_COLS=$(tput cols 2>/dev/null) || PROGRESS_COLS=80
    printf "\033[2J\033[1;%dr\033[H" "$(( PROGRESS_LINES - 1 ))" >&2
    PROGRESS_ENABLED=true
    printf "\0337\033[%d;1H${INDICATOR_PROC}\033[5m${MSG[status_preparing]}${FORMATTING_RESET}\033[K\0338" \
        "$PROGRESS_LINES" >&2
    trap 'handle_resize' WINCH
}


show_progress_bar() {
    local current total bytes label
    local term_width term_lines human_bytes stats stats_len label_len pct pct_len
    local bar_width filled bar j tail tail_raw tail_len
    local now_epoch elapsed rate remaining eta_epoch eta_str
    
    current="$1"
    total="$2"
    bytes="${3:-0}"
    label="${4:-Processing}"

    if [[ ! -t 2 || "$PROGRESS_ENABLED" != "true" ]]; then
        return 0
    fi
    if [[ "$VERBOSE" != "true" ]]; then
        return 0
    fi

    # Geometry comes exclusively from the cached values measured
    # ONCE in progress_init() — never re-measured here.
    term_width="$PROGRESS_COLS"
    term_lines="$PROGRESS_LINES"
    pct=0

    [[ "$total" -gt 0 ]] && pct=$(( current * 100 / total ))

    human_bytes=$(numfmt --to=iec-i --suffix=B "$bytes" 2>/dev/null) \
        || human_bytes="${bytes}B"

    # ── Stats layout: "N/M files (Size)" ──
    files_string="$current/$total"
    stats="$files_string ${MSG[label_files]} ($human_bytes)"
    stats_len=${#stats}
    label_len=${#label}
    pct_len=4
  
    now_epoch=$(date +%s)
    elapsed=0

    if (( PROGRESS_PHASE_EPOCH > 0 && current > 0 )); then
        elapsed=$(( now_epoch - PROGRESS_PHASE_EPOCH ))
    fi

    # ── Tail: raw variant first, normalized to 20 columns below ──
    # Values longer than 20 columns are truncated by the progress bar 
    # normalizer; keep all ETA-related strings ≤ 20 columns.
    if (( current == total && total > 0 )); then
        tail_raw="${MSG[info_eta_completed]}"
    elif (( elapsed >= 5 && PROGRESS_PHASE_EPOCH > 0 && current > 0 )); then
        rate=$(awk -v c="$current" -v e="$elapsed" \
            'BEGIN { if (e>0) printf "%.2f", c/e; else print 0 }')
        remaining=$(( total - current ))
        eta_epoch=$(awk -v r="$rate" -v f="$remaining" -v n="$now_epoch" \
            'BEGIN { if (r>0) printf "%.0f", n + f/r; else print n }')
        eta_str=$(date -d "@$eta_epoch" '+%Y-%m-%d %H:%M')
        tail_raw="${MSG[info_eta_calculating_prefix]} $eta_str"
    else
        tail_raw="${MSG[info_eta_calculating]}"
    fi

    # Normalize tail to EXACTLY 20 columns: pad short translations,
    # truncate overlong ones — bar geometry is locale-proof.
    # shellcheck disable=SC2034
    tail=$(printf '%-20.20s' "$tail_raw")
    tail_len=20

    # ── Width budget ──
    bar_width=$(( term_width - label_len - stats_len - pct_len - tail_len - 7 ))
    pct_str=$(printf '%4s' "$pct%")

    if (( bar_width < 4 )); then
        bar_width=4
    fi

    filled=$(( pct * bar_width / 100 ))
    [[ "$filled" -gt "$bar_width" ]] && filled=$bar_width

    bar=""
    for ((j = 0; j < filled; j++)); do bar+="▓"; done
    for ((j = filled; j < bar_width; j++)); do bar+="░"; done

    printf "\0337\033[%d;1H${INDICATOR_PROC}%s${FORMATTING_RESET} %s %s %s %s\033[K\0338" \
        "$term_lines" "$label" "$stats" "$bar" "$pct_str" "$tail_raw" >&2

    PROGRESS_DREW=true
}



# ───── Progress Teardown ──────────────────────────────────
# Clears the progress-bar line and restores cursor state at
# phase boundaries — without it, the last bar frame bleeds
# into the next INFO line (cosmetic, but confusing in logs).

progress_teardown() {
    if [[ "$PROGRESS_ENABLED" == "true" ]]; then
        # Release the scroll region
        printf "\033[r" >&2
        if [[ "$PROGRESS_DREW" == "true" ]]; then
            # Final bar exists — keep it as end-state, park cursor
            printf "\033[%d;1H\n\n" "$PROGRESS_LINES" >&2
        else
            # No bar was ever drawn — the bridge line is stale,
            # wipe it instead of preserving it
            printf "\033[%d;1H\033[K" "$PROGRESS_LINES" >&2
        fi
        PROGRESS_ENABLED=false
    fi
}



# ───── Run Summary ────────────────────────────────────────
# The single exit report: counters for uploaded, skipped,
# failed, retried and deleted, plus the commit verdict.
# Everything print_summary states derives from counters the
# phases incremented — no re-analysis, no drift.

print_summary() {
    echo ""
    if [[ "$ERROR_COUNT" -gt 0 ]]; then
        echo -e "${INDICATOR_WARN}${MSG[sum_completed_errors]}${FORMATTING_RESET}"
    else
        echo -e "${INDICATOR_PASS}${MSG[sum_completed_ok]}${FORMATTING_RESET}"
    fi
    printf "  %s %s\n" "$(pad_to "${MSG[sum_uploaded]}" "$PAD_SUMMARY_WIDTH")" "$UPLOAD_COUNT"
    printf "  %s %s\n" "$(pad_to "${MSG[sum_skipped]}" "$PAD_SUMMARY_WIDTH")" "$SKIP_COUNT"
    printf "  %s %s\n" "$(pad_to "${MSG[mode_verb_${DELETE_MODE}]}" "$PAD_SUMMARY_WIDTH")" "$DELETE_COUNT"
    if (( RETRIED_COUNT > 0 )); then
        # shellcheck disable=SC2059
        info "$(printf '%s %s' \
            "$(pad_to "${MSG[sum_retried]}" "$PAD_SUMMARY_WIDTH")" "$RETRIED_COUNT")"
    fi
    if (( ${#RETRY_QUEUE[@]} > 0 )); then
        # shellcheck disable=SC2059
        info "$(printf '%s %s' \
            "$(pad_to "${MSG[sum_retry_pending]}" "$PAD_SUMMARY_WIDTH")" "${#RETRY_QUEUE[@]}")"
    fi
    printf "  %s %s\n" "$(pad_to "${MSG[sum_errors]}" "$PAD_SUMMARY_WIDTH")" "$ERROR_COUNT"
    printf "  %s %s\n" "$(pad_to "${MSG[sum_warnings]}" "$PAD_SUMMARY_WIDTH")" "$WARNING_COUNT"
    log "[SUMMARY] Uploaded: $UPLOAD_COUNT, Skipped: $SKIP_COUNT, ${DELETE_MODE^}d: $DELETE_COUNT, Errors: $ERROR_COUNT, Warnings: $WARNING_COUNT"
}



# ───── Cleanup Trap ───────────────────────────────────────
# Registered early via trap, runs on EXIT regardless of the
# exit cause (normal, Ctrl-C, set -u abort): removes temp
# files, releases the lock, closes FD 3. Idempotent throughout
# — a trap firing on an half-initialized run must not itself
# fail halfway.

cleanup() {
    rm -rf "$CONFIG_DIR/tmp" 2>/dev/null || true
    rm -f "$TMP_ERR_FILE" 2>/dev/null || true

    if [[ "$PREVIOUS_DB_PATH" != "/dev/null" && -f "$PREVIOUS_DB_PATH" ]]; then
        rm -f "$PREVIOUS_DB_PATH"
    fi

    # Uncommitted staging is garbage, never authoritative —
    # defensive, even though commit_db() should have consumed it
    [[ -n "${NEW_DB_PATH:-}" && -f "$NEW_DB_PATH" ]] && rm -f "$NEW_DB_PATH"

    # Summary FIRST — while the scroll region is still active, so
    # scrolling output can never touch the bar on the reserved line.
    print_summary

    # Teardown SECOND — releases the region and arranges the prompt
    # one blank line below the (persisting) progress bar.
    progress_teardown

    if [[ "$ERROR_COUNT" -gt 0 ]]; then
        log "[WARN] Backup completed with $ERROR_COUNT errors."
    elif [[ "$WARNING_COUNT" -gt 0 ]]; then
        log "[INFO] Backup completed with $WARNING_COUNT warnings."
    else
        log "[SUCCESS] Backup completed cleanly."
    fi

    log "[INFO] Cleanup finished. Session ended."
}



# ── Signal path: temp hygiene only ─────────────────────
# Interrupts must NOT run full cleanup() — summary and
# scroll-region teardown belong to completed runs. The
# garbage disposal is sufficient: uncommitted staging is
# never authoritative; the old DB stands and the next run
# recovers (see commit_db contract).

abort_cleanup() {
    [[ -n "${NEW_DB_PATH:-}" && -f "$NEW_DB_PATH" ]] \
        && rm -f "$NEW_DB_PATH" \
        && NEW_DB_PATH=""
    [[ "${PREVIOUS_DB_PATH:-}" != "/dev/null" && -f "${PREVIOUS_DB_PATH:-}" ]] \
        && rm -f "$PREVIOUS_DB_PATH"
    rm -f "${TMP_ERR_FILE:-}" 2>/dev/null || true
}



# ───── Main Dispatch ──────────────────────────────────────
# Orchestrates the run order: dependencies → lock → session →
# load → upload → retry → delete → commit → prune. Order is
# the architecture: each phase may safely assume every earlier
# one validated its territory.

main() {
    # Locale first (localized errors for unknown options), then args,
    # then config (values are only needed AFTER parse_args succeeded).
    if [[ -f "$LOCALE_FILE" && "$SYSTEM_LANG" != "en" ]]; then
        load_locale "$LOCALE_FILE"
    else
        load_locale "$FALLBACK_FILE"
    fi

    parse_args "$@"
    load_config

    # Config is user input — validate contracts before trusting them.
    # ${VAR:-} everywhere: with set -u, direct references to unset
    # variables abort the script BEFORE a localized message can fire.
    # The guards must be the ones reporting, not the shell.

    case "${DELETE_MODE:-}" in trash|delete) ;; *)
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "DELETE_MODE" "${DELETE_MODE:-}" "${MSG[fail_val_delete]}")"
        exit 1 ;; esac

    case "${UPLOAD_CONFLICT_STRATEGY:-}" in replace|skip) ;; *)
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "UPLOAD_CONFLICT_STRATEGY" "${UPLOAD_CONFLICT_STRATEGY:-}" "${MSG[fail_val_conflict]}")"
        exit 1 ;; esac

    if [[ ! "${CRON_INTERVAL_MINUTES:-}" =~ ^[1-9][0-9]*$ ]]; then
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "CRON_INTERVAL_MINUTES" "${CRON_INTERVAL_MINUTES:-}" "${MSG[fail_val_cron_positive]}")"
        exit 1
    elif (( CRON_INTERVAL_MINUTES > 60 && CRON_INTERVAL_MINUTES % 60 != 0 )); then
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "CRON_INTERVAL_MINUTES" "$CRON_INTERVAL_MINUTES" "${MSG[fail_val_cron_divisible]}")"
        exit 1
    fi

    # Retention bound: prune_old_runs feeds KEEP_LOG_RUNS directly
    # into tail -n +N arithmetic — a non-positive value prunes all
    # archives (data loss) or keeps them all silently.

    if [[ ! "${KEEP_LOG_RUNS:-}" =~ ^[1-9][0-9]*$ ]]; then
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "KEEP_LOG_RUNS" "${KEEP_LOG_RUNS:-}" "${MSG[fail_val_keep_log_runs]}")"
        exit 1
    fi

    # Retry queue bounds: attempts ceiling and backoff base.
    # The ceiling caps persistent retry pressure; the upper
    # bound of 10 prevents runaway exponentiation in sleep
    # arithmetic (documented deviation: a larger value makes
    # no sense for transient API errors).

    if [[ ! "${RETRY_MAX_ATTEMPTS:-}" =~ ^[1-9][0-9]*$ ]] || (( RETRY_MAX_ATTEMPTS > 10 )); then
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "RETRY_MAX_ATTEMPTS" "${RETRY_MAX_ATTEMPTS:-}" "${MSG[fail_val_retry_attempts]}")"
        exit 1
    fi

    if [[ ! "${RETRY_BACKOFF_BASE:-}" =~ ^[1-9][0-9]*$ ]]; then
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "RETRY_BACKOFF_BASE" "${RETRY_BACKOFF_BASE:-}" "${MSG[fail_val_retry_backoff]}")"
        exit 1
    fi

    # Check for updates opt-in flag
    case "${CHECK_UPDATES:-}" in
        true|false) ;;
        *)
            # shellcheck disable=SC2059
            fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "CHECK_UPDATES" "${CHECK_UPDATES:-}" "${MSG[fail_val_bool]}")"
            exit 1
            ;;
    esac

    # SOURCE_BASE anchors relative SOURCE_DIRS entries; an empty or
    # relative value would expand backups into unintended locations.

    if [[ -z "${SOURCE_BASE:-}" || "${SOURCE_BASE:-}" != /* ]]; then
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "SOURCE_BASE" "${SOURCE_BASE:-}" "${MSG[fail_val_source_base]}")"
        exit 1
    fi

    if [[ -z "${SOURCE_DIRS+x}" || ${#SOURCE_DIRS[@]} -eq 0 ]]; then
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[tmpl_fail_invalid_value]}" "SOURCE_DIRS" "" "${MSG[fail_val_source_dirs]}")"
        exit 1
    fi

    # Expand relative SOURCE_DIRS entries against SOURCE_BASE;
    # absolute paths (leading /) pass through unchanged.

    local i

    for i in "${!SOURCE_DIRS[@]}"; do
        if [[ "${SOURCE_DIRS[i]}" != /* ]]; then
            SOURCE_DIRS[i]="$SOURCE_BASE/${SOURCE_DIRS[i]}"
        fi
    done

    if [[ "$SHOW_HELP" == "true" ]]; then
        show_help
    fi

    if [[ "$SHOW_VERSION" == "true" ]]; then
        show_version
    fi

    if [[ "$SHOW_LOG" == "true" ]]; then
        show_log
    fi

    if [[ "$SCHEDULE_CRON" == "true" ]]; then
        schedule_cron
    fi

    if [[ "$UNSCHEDULE_CRON" == "true" ]]; then
        unschedule_cron
    fi

    if [[ "$RUN_BACKUP" == "false" && "$SHOW_HELP" == "false" && \
          "$SHOW_VERSION" == "false" && "$SHOW_LOG" == "false" && \
          "$SCHEDULE_CRON" == "false" && "$UNSCHEDULE_CRON" == "false" ]]; then
        show_menu
        exit 0
    fi

    progress_init
    show_header

    if [[ "$QUIET_MODE" == "true" ]]; then
        notice "${MSG[quiet_notice]}"
        echo "       $SCRIPT_NAME --log"
    fi

    mkdir -p "$CONFIG_DIR"
    mkdir -p "$LOG_DIR"

    acquire_lock            # mutex FIRST — before touching shared state
    check_dependencies      # fail fast, localized
    archive_completed_runs  # bundle previous runs (pre-next-run)
    prune_old_runs          # enforce retention
    ensure_session || exit 1

    info "${MSG[info_config_header]}"
    printf "   %s %s\n" "$(pad_to "├ ${MSG[info_conflict_strategy]}" "$PAD_CONFIG_WIDTH")" "$UPLOAD_CONFLICT_STRATEGY"
    printf "   %s %s\n" "$(pad_to "├ ${MSG[info_delete_mode]}" "$PAD_CONFIG_WIDTH")" "$DELETE_MODE"
    printf "   %s %s\n" "$(pad_to "├ ${MSG[info_dry_run]}" "$PAD_CONFIG_WIDTH")" "$DRY_RUN"
    printf "   %s %s\n" "$(pad_to "╰ ${MSG[info_reset_db]}" "$PAD_CONFIG_WIDTH")" "$RESET_DB"
    
    load_local_db

    if [[ "$VERBOSE" == "true" ]]; then
        exec 3>>"$TRANSFER_LOG"
    else
        exec 3>/dev/null
    fi

    retry_queue_load
    retry_queue_process
    compare_and_upload
    compare_and_delete
    commit_db
    cleanup
}

# Entry point
main "$@"

# End of script
