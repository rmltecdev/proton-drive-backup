# ───── Version Output ─────────────────────────────────────
# Prints the single source of truth SCRIPT_VERSION — the same
# constant the smoke test compares against README.md and
# CHANGELOG.md. Never hardcode a version string here.

show_version() {
    show_header
    printf "  %s v%s\n" "$(pad_to "${MSG[info_version]}" "$PAD_VERSION_WIDTH")" "$VERSION"
    printf "  %s %s\n" "$(pad_to "${MSG[info_build_date]}" "$PAD_VERSION_WIDTH")" "$BUILD_DATE"
    printf "  %s %s\n" "$(pad_to "${MSG[info_path]}" "$PAD_VERSION_WIDTH")" "$SCRIPT_PATH"
    
    check_for_updates

    printf "\n  %s\n" "${MSG[info_cli_version]}"

