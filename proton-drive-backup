load_locale() {
    local target_file
    target_file="$1"
    if [[ ! -f "$target_file" ]]; then
        show_header
        printf "\033[31m■ Localization error\033[0m\n" >&2
        printf "  Missing fallback file %s.\n" "$target_file" >&2
        printf "  Ensure language files are in same directory as script.\n" >&2
        exit 1
    fi
    # shellcheck disable=SC1090
    source "$target_file"
    log "[INFO] Loaded localization from $target_file"
}



# ───── Load User Configuration ───────────────────────────────
# User decisions live in an external config file (XDG), never in
# the script itself — updates can never overwrite user settings.
# Abort contract (same as load_locale()): a missing or syntactically
# invalid file stops EVERY operating mode with a clear, localized
# message.

load_config() {
    # TMP_ERR_FILE lives in CONFIG_DIR — it must exist in every
    # operating mode (menu, --help, backup) before the redirect
    # below, or the redirect failure masquerades as a syntax error.
    mkdir -p "$CONFIG_DIR"

    local example_config
    example_config="${SCRIPT_DIR}/${SCRIPT_NAME}.cfg.example"

    if [[ ! -f "$CONFIG_FILE" ]]; then
        show_header
        # shellcheck disable=SC2059
        fail "$(printf "%s\n         %s" "${MSG[fail_config_missing]}" "$CONFIG_FILE")"
        # shellcheck disable=SC2059
        echo "  $(printf "${MSG[fail_config_hint]}" "$example_config")"
        exit 1
    fi

    if ! bash -n "$CONFIG_FILE" 2> "$TMP_ERR_FILE"; then
        show_header
        # shellcheck disable=SC2059
        fail "$(printf "${MSG[fail_config_syntax]}" "$CONFIG_FILE")"
        sed "s|^$CONFIG_FILE: ||" "$TMP_ERR_FILE" | sed 's/^/  /' >&2
        exit 1
    fi

    # shellcheck disable=SC1090
    source "$CONFIG_FILE"
    log "[INFO] Loaded configuration from $CONFIG_FILE"
}



# ───── Show Menu (no arguments invoked) ───────────────

is_cron_scheduled() {
    crontab -l 2>/dev/null | grep -q "$SCRIPT_PATH"
}

show_menu() {
    local cron_status db_files log_size

    if is_cron_scheduled; then
        cron_status="${INDICATOR_PASS}Yes${FORMATTING_RESET}"
    else
        cron_status="${INDICATOR_FAIL}No${FORMATTING_RESET}"
    fi

    db_files=0

    if [[ -f "$CHECKSUM_DB" ]]; then
        db_files=$(jq '.entries | length' "$CHECKSUM_DB" 2>/dev/null) || db_files=0
    fi

    log_size="0 KB"

    if [[ -f "$RUNTIME_LOG" ]]; then

        local raw_size

        raw_size=$(stat -c%s "$RUNTIME_LOG" 2>/dev/null) || raw_size=0

        if [[ "$raw_size" -ge 1048576 ]]; then
            log_size="$(awk "BEGIN {printf \"%.1f\", $raw_size/1048576}") MB"
        else
            log_size="$(awk "BEGIN {printf \"%.0f\", $raw_size/1024}") KB"
        fi
    fi

    show_header

    # shellcheck disable=SC2059
    printf "${MSG[menu_status]}\n"
    printf "├ %s %b\n" "$(pad_to "${MSG[menu_cron_label]}" "$PAD_STATUS_WIDTH")" "$cron_status"
    printf "├ %s %s %s\n" "$(pad_to "${MSG[menu_db_label]}" "$PAD_STATUS_WIDTH")" "$db_files" "${MSG[menu_files_tracked]}"
    printf "╰ %s %s\n\n" "$(pad_to "${MSG[menu_logsize_label]}" "$PAD_STATUS_WIDTH")" "$log_size"

    # shellcheck disable=SC2059
    printf "${MSG[tmpl_menu_invoke]}\n" "$SCRIPT_NAME"
    printf "├ %s %s\n" "$(pad_to "--checksum" "$PAD_OPTION_WIDTH")" "${MSG[opt_checksum]}"
    printf "├ %s %s\n" "$(pad_to "--dry-run" "$PAD_OPTION_WIDTH")" "${MSG[opt_dry_run]}"
    printf "├ %s %s\n" "$(pad_to "--help" "$PAD_OPTION_WIDTH")" "${MSG[opt_help]}"
    printf "├ %s %s\n" "$(pad_to "--log" "$PAD_OPTION_WIDTH")" "${MSG[opt_log]}"
    printf "├ %s %s\n" "$(pad_to "--quiet" "$PAD_OPTION_WIDTH")" "${MSG[opt_quiet]}"
    printf "├ %s %s\n" "$(pad_to "--reset-db" "$PAD_OPTION_WIDTH")" "${MSG[opt_reset_db]}"
    printf "├ %s %s\n" "$(pad_to "--schedule" "$PAD_OPTION_WIDTH")" "${MSG[opt_schedule]}"
    printf "├ %s %s\n" "$(pad_to "--unschedule" "$PAD_OPTION_WIDTH")" "${MSG[opt_unschedule]}"
    printf "├ %s %s\n" "$(pad_to "--verbose" "$PAD_OPTION_WIDTH")" "${MSG[opt_verbose]}"
    printf "╰ %s %s\n\n" "$(pad_to "--version" "$PAD_OPTION_WIDTH")" "${MSG[opt_version]}"

    # shellcheck disable=SC2059
    printf "${MSG[menu_paths]}\n"
    printf "├ %s %s\n" "$(pad_to "${MSG[menu_script]}" "$PAD_MENU_WIDTH")" "$SCRIPT_PATH"
