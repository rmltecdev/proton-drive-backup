# ───── Low-Level Logging (file only) ──────────────────────

log() {
    local message

    message="${1:-}"

    [[ -d "$LOG_DIR" ]] || mkdir -p "$LOG_DIR"
    printf "[%s] [%s, v%s] %s\n" \
        "$(date '+%Y-%m-%d %H:%M:%S')" "$SCRIPT_NAME" "$VERSION" "$message" \
        >> "$RUNTIME_LOG"
}



# ───── Thai language handling ─────────────────────────────
# Thai zero-width combining marks: vowels/tone signs above and
# below the baseline (U+0E31, U+0E34-U+0E3A, U+0E47-U+0E4E).
# They render at width 0 but count in ${#var}. Defined ONCE.

THAI_ZW_CHARS=$'\u0e31\u0e34\u0e35\u0e36\u0e37\u0e38\u0e39\u0e3a\u0e47\u0e48\u0e49\u0e4a\u0e4b\u0e4c\u0e4d\u0e4e'



# ───── Display width: glyph count minus zero-width marks ──
# Requires an active UTF-8 locale: ${s:i:1} walks glyphs only
# when the shell's multibyte mode is on (same dependency as
# pad_to's glyph counting — C locale degrades to bytes).

display_width() {
    local s="$1" out="" i c
    for (( i = 0; i < ${#s}; i++ )); do
        c="${s:i:1}"
        [[ "$THAI_ZW_CHARS" == *"$c"* ]] || out+="$c"
    done
    printf '%s' "${#out}"
}



# ───── Display-width-correct padding ──────────────────────
# bash's printf counts BYTES for %-*s field widths; UTF-8
# multibyte glyphs (ä ö ü ß) therefore shift columns left
# (2 bytes = 1 glyph). ${#var} counts GLYPHS — we measure
# ourselves and let printf print only ASCII spaces.

pad_to() {
    local text width w n
    
    text="$1"
    width="$2"

    w=$(display_width "$text")
    n=$(( width - w ))
    (( n < 0 )) && n=0

    printf "%s" "$text"
    printf "%*s" "$n" ""
}



# ───── Phase-Level Message Functions ──────────────────────
# Always write to log file. Console output controlled by QUIET_MODE.

info() {
    log "[INFO] ${1:-}"
    if [[ "$QUIET_MODE" != "true" ]]; then
        echo -e "${INDICATOR_INFO}${FORMATTING_RESET}${1:-}"
    fi
}

proc() {
    log "[PROCESSING] ${1:-}"
    if [[ "$QUIET_MODE" != "true" ]]; then
        echo -e "   ${INDICATOR_PROC}${FORMATTING_RESET}${1:-}"
    fi
}

notice() {
    log "[NOTICE] ${1:-}"
    echo -e "${INDICATOR_INFO}Note${FORMATTING_RESET}${1:-}"
}

warn() {
    [[ -d "$LOG_DIR" ]] && log "[WARN] ${1:-}"
    echo -e "${INDICATOR_WARN}${FORMATTING_RESET}${1:-}" >&2
}

fail() {
    log "[ERROR] ${1:-}"
    echo -e "${INDICATOR_FAIL}${FORMATTING_RESET}${1:-}" >&2
}

success() {
    log "[SUCCESS] ${1:-}"
    if [[ "$QUIET_MODE" != "true" ]]; then
        echo -e "${INDICATOR_PASS}${FORMATTING_RESET}${1:-}"
    fi
}

detail_info() {
    log "[INFO] ${1:-}"
}

detail_success() {
